<resources xmlns:tools="http://schemas.android.com/tools">
<!-- Base application theme. -->
<style name="Base.Theme.GodsLambs" parent="Theme.Material3.DayNight.NoActionBar">
    <!-- Customize your light theme here. -->
    <item name="colorPrimary">@color/colorAccent</item>
</style>

<style name="Theme.GodsLambs" parent="Base.Theme.GodsLambs" />
    <style name="AlertDialogTheme" parent="Theme.Material3.Light.Dialog">
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.MyDialog</item>
    </style>

    <style name="ShapeAppearance.MyDialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">24dp</item>
    </style>


    <style name="MyAlertDialogStyle" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:windowMinWidthMajor">75%</item>
        <item name="android:windowMinWidthMinor">75%</item>
    </style>


    <style name="iOSDialogStyle" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowAnimationStyle">@style/iOSDialogAnimation</item>
    </style>

    <style name="iOSDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/ios_fade_in</item>
        <item name="android:windowExitAnimation">@anim/ios_fade_out</item>
    </style>

</resources>